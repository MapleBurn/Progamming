@page "/login"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Identity
@using WorkTracer.Services
@using Microsoft.AspNetCore.Http.Features
@using Microsoft.AspNetCore.WebUtilities

@inject NavigationManager navigation
@inject SignInManager<ApplicationUser> SignInManager

<PageTitle>Login</PageTitle>

<div class="d-flex justify-content-center align-items-center min-vh-100 bg-light">
    <div class="card shadow p-4" style="width: 100%; max-width: 400px;">
        <h3 class="text-center mb-4">Login</h3>

        @if (loginError)
        {
            <div class="alert alert-danger" role="alert">
                <strong>Error:</strong> Incorrect username or password.
            </div>
        }

        <EditForm Model="@Credentials" OnValidSubmit="HandleLogin" FormName="LoginForm">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <InputText @bind-Value="Credentials.Username" class="form-control" placeholder="Username" />
            </div>

            <div class="mb-3">
                <InputText @bind-Value="Credentials.Password" type="password" class="form-control" placeholder="Password" />
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-primary">Login</button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    LoginModel Credentials = new LoginModel();
    private bool loginError = false;

    protected override void OnInitialized()
    {
        var uri = new Uri(navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        loginError = query.ContainsKey("error") && query["error"] == "true";
    }

    private async Task HandleLogin(EditContext obj)
    {
        var url = $"onlogin?username={Credentials.Username}&password={Credentials.Password}";
        navigation.NavigateTo(url, forceLoad: true); // triggers full page post
    }
}