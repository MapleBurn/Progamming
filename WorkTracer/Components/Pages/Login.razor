@page "/login"
@rendermode InteractiveServer
@using System.Net
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@inject AuthService authService
@inject NavigationManager navigation

<PageTitle>Login</PageTitle>

<form FormName="LoginDialog" asp-controller="Auth" asp-action="Auth/CookieLogin" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <input id="Username" asp-for="Username" class="form-control" placeholder="Enter your username"/>
    </div>
    <div class="mb-3">
        <input id="Password" type="password" asp-for="Password" class="form-control" placeholder="Enter your password"/>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <button type="submit" class="btn btn-primary" >Log in</button>
    </div>
</form>

@if (true)
{
    <div class="alert alert-danger" role="alert">
        <p><strong>Error:</strong> incorrect username or password.</p>
    </div>
}

