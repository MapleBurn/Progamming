@page "/"
@rendermode InteractiveServer

@inject NavigationManager navigation

<PageTitle>Home</PageTitle>

<h1 class="display-4 text-primary fw-bold mb-4">WorkTracer 1.0</h1>

<AuthorizeView>
    <Authorized>
        <div class="container py-4 bg-light rounded shadow-sm">
            <h5 class="mb-3 text-secondary">Welcome back!</h5>
            <p class="lead">
                Use the <strong>Planner</strong> tab to log your work hours daily.
                Review your <strong>work summary</strong>, including overtime, lunch, and categorized activities, in the <strong>Overview</strong> tab.
            </p>
            <hr />
            <p class="text-muted small">Need help? Contact your administrator for assistance or help with roles.</p>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="container py-4 bg-white rounded shadow-sm border border-2">
            <h5 class="text-danger mb-3">Access Restricted</h5>
            <p class="lead">
                To access your work tracker, please log in to your company account.
            </p>
            <button class="btn btn-primary btn-lg mt-3" @onclick="RedirectToLogin">
                <i class="bi bi-box-arrow-in-right me-2"></i> Log in
            </button>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code
{
    private void RedirectToLogin()
    {
        navigation.NavigateTo("/login");
    }
}

