@page "/overview"
@using Microsoft.EntityFrameworkCore
@using WorkTracer.Data
@attribute [Authorize]

@rendermode InteractiveServer

@inject NavigationManager navigation
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>overview</PageTitle>

<div class="container my-4">
  <h2 class="mb-4 text-primary">Work Overview</h2>

<div class="row gy-4">
  <div class="col-12 col-lg-5">
    <div class="card shadow-sm h-100">
      <div class="card-header d-flex justify-content-between align-items-center bg-primary text-white">
        <button class="btn btn-sm btn-light text-primary" @onclick="PrevWeek">
          <i class="bi bi-chevron-left"></i>
        </button>
        <strong>@CurrentWeekLabel</strong>
        <button class="btn btn-sm btn-light text-primary" @onclick="NextWeek">
          <i class="bi bi-chevron-right"></i>
        </button>
      </div>
      <div class="card-body">
        <h5 class="card-title mb-3">@currentUser.Username</h5>
        <dl class="row">
          <dt class="col-6">Worked Hours</dt>
          <dd class="col-6">@workedHours</dd>

          <dt class="col-6">Lunch Time</dt>
          <dd class="col-6">@LunchTime</dd>

          <dt class="col-12 mt-3">Top Project</dt>
          <dd class="col-12 fw-semibold">@TopProjectName</dd>
        </dl>
      </div>
    </div>
  </div>
</div>
</div>

@code {

  // --- Example backing properties (replace with your real data sources) ---
  private UserRecord currentUser;
  int workedHours;
  int LunchTime;
  //TimeSpan Overtime = TimeSpan.FromHours(8);
  string TopProjectName;

  DateTime CurrentWeekStart = DateTime.Today;
  string CurrentWeekLabel => $"{CurrentWeekStart:MMM d} – {CurrentWeekStart.AddDays(6):MMM d}";

  void PrevWeek()
  {
    CurrentWeekStart = CurrentWeekStart.AddDays(-7);
  }

  void NextWeek()
  {
    CurrentWeekStart = CurrentWeekStart.AddDays(7);
  }

  protected override async Task OnInitializedAsync()
  {
    //get the user
    var username = AuthenticationStateProvider.GetAuthenticationStateAsync().Result.User.Identity.Name;
    var current = await Db.Users.Where(u => u.Username == username).ToListAsync();
    currentUser = current[0];
    
    // load events
    workedHours = await GetTotalHoursAsync();
    LunchTime = await GetTotalLunchAsync();
    TopProjectName = await GetMostFrequentEventAsync();
  }
  
  public async Task<int> GetTotalHoursAsync()
  {
    var records = await Db.PlannerEvents
      .AsNoTracking()
      .Where(e => e.IsPaid == true)
      .ToListAsync();

    if (records == null || records.Count == 0)
    {
      return 0;
    }

    var totalDuration = records
      .Select(r => r.EndTime - r.StartTime)
      .Aggregate(TimeSpan.Zero, (sum, span) => sum + span);

    // Return total hours rounded to the nearest whole number
    return (int)Math.Round(totalDuration.TotalHours);
  }
  
  public async Task<int> GetTotalLunchAsync()
  {
    var records = await Db.PlannerEvents
      .AsNoTracking()
      .Where(e => e.IsPaid == false)
      .ToListAsync();

    if (records == null || records.Count == 0)
    {
      return 0;
    }

    var totalDuration = records
      .Select(r => r.EndTime - r.StartTime)
      .Aggregate(TimeSpan.Zero, (sum, span) => sum + span);

    // Return total hours rounded to the nearest whole number
    return (int)Math.Round(totalDuration.TotalHours);
  }
  
  public async Task<string> GetMostFrequentEventAsync()
  {
    var mostFrequent = await Db.PlannerEvents
      .AsNoTracking()
      .Where(e => !string.IsNullOrEmpty(e.Name)) // Ignore null/empty names
      .GroupBy(e => e.Name)
      .OrderByDescending(g => g.Count())
      .Select(g => g.Key)
      .FirstOrDefaultAsync();

    return mostFrequent ?? "No records";
  }

}
