@page "/overview"
@rendermode InteractiveServer

@inject AuthService authService
@inject NavigationManager navigation

<PageTitle>overview</PageTitle>

<h1>Work overview</h1>

<p>
    here will be two graphs, one for the info about worked hours in the chosen month,
     and the other one for the whole year.
</p>

<button class="btn btn-primary" @onclick="IncrementCount">Grill a random person alive</button>

@code {
    private bool redirected = false;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && !authService.isLoggedIn && !redirected)
        {
            redirected = true; // Prevent redirect loop
            navigation.NavigateTo("/login");
        }
    }

    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }

}