@page "/planner"
@rendermode InteractiveServer
@attribute [Authorize]
@inject NavigationManager navigation
@using System.Runtime.InteropServices.JavaScript
@using WorkTracer.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="planner-container">
    <!-- Header Row -->
    <div class="row planner-header">
        <div class="col"></div>
        <div class="col text-center">Monday</div>
        <div class="col text-center">Tuesday</div>
        <div class="col text-center">Wednesday</div>
        <div class="col text-center">Thursday</div>
        <div class="col text-center">Friday</div>
        <div class="col text-center">Saturday</div>
        <div class="col text-center">Sunday</div>
    </div>
    
    <!-- Grid cells -->
    <div class="row">
        @for (int col = 0; col <= 7; col++)
        {
            int currentCol = col;
            <div class="col p-0">
                <div id="@($"col-{currentCol}")" style="position: relative; height: 960px;">
                    @for (int hour = 0; hour < 24; hour++)
                    {
                        int currentHour = hour;
                        <div class="planner-cell @(IsSelected(currentCol, currentHour) ? "selecting" : "")" 
                             @onmousedown="() => HandleMouseDown(currentCol, currentHour)" 
                             @onmousemove="() => HandleMouseMove(currentCol, currentHour)"
                             @onmouseup="HandleMouseUp"
                             data-col="@currentCol" 
                             data-hour="@currentHour">
                            
                            @if (col == 0)
                            {
                                <div class="hour-label">@(currentHour):00</div>
                            }
                        </div>
                    }
                    
                    @foreach (var evt in GetEventsInColumn(currentCol))
                    {
                        @if (((int)evt.StartTime.DayOfWeek + 6) % 7 + 1 > 0)
                        {
                            double minHour = evt.StartTime.Hour + evt.StartTime.Minute/60d;
                            double maxHour = evt.EndTime.Hour + evt.EndTime.Minute/60d;
                            <div class="event-block"
                                 style="top: @((int)(minHour * 40))px; height: @((int)((maxHour - minHour) * 40))px; background: @evt.Color"
                                 data-event-id="@evt.Id"
                                 @onclick:stopPropagation="true"
                                 @onclick="() => ShowEditModal(evt.LocalId)">
                                <p1>@evt.Name</p1><br><br>
                                <p1 style="overflow-wrap: break-word; word-break: break-all; white-space: pre-wrap;">
                                    @evt.Text
                                </p1>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Edit Event Modal -->
<div class="modal @ModalClass" tabindex="-1" role="dialog" style="display:@ModalDisplay">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Event</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" @onclick="CloseModal"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-between">
                    <input type="text" id="editEventName" class="form-control mb-3" placeholder="Event name" @bind="EditEventName">
                    <input type="color" id="colorSelector" @bind-value="SelectedColor" class="form-control form-control-color mb-3"/>
                </div>
                <InputTextArea id="EditEventText" class="form-control mb-3" placeholder="Text" @bind-Value="EditEventText" rows="6"/>
                <div class="d-flex justify-content-between">
                    <input type="time" id="startTime" class="form-control mb-3" @bind="startTime"/>
                    <input type="time" id="endTime" class="form-control mb-3" @bind="endTime"/>
                </div>
                <div class="d-flex justify-content-between">
                    <button type="button" class="btn btn-danger mb-3" id="deleteEvent" @onclick="DeleteEvent">Delete</button>
                    <button type="button" class="btn btn-primary mb-3" id="saveEvent" @onclick="SaveEvent">Save Changes</button>
                </div>
                @if (AlertClass != "") {<div class="alert @AlertClass d-flex align-items-center justify-content-center"><p>@AlertText</p></div>}
            </div>
        </div>
    </div>
</div>

@if (ShowBackdrop)
{
    <div class="modal-backdrop fade show"></div>
}

@code {
    private List<PlannerEvent> events = new List<PlannerEvent>();   //all events from the database
    private List<PlannerEvent> userEvents = new List<PlannerEvent>();   //events for the current user
    private PlannerEvent currentEvent;
    private EventWeek currentEventWeek;
    private bool isSelecting;
    private int? startCol;
    private List<(int col, int hour)> currentSelection = new List<(int col, int hour)>();
    
    // Modal properties
    private string ModalDisplay = "none";
    private string ModalClass = "";
    private bool ShowBackdrop;
    private string AlertClass ="";
    private string AlertText;
    private string EditEventName { get; set; } = "";
    private string EditEventText { get; set; } = "";
    private DateTime startTime;
    private DateTime endTime;
    private string SelectedColor { get; set; } = "#e1f5fe";
    
    protected override async Task OnInitializedAsync()
    {   
        await GetDataFromDB();
        await GetUserDataFromDB();
        currentEventWeek = new EventWeek();
        currentEventWeek.StartDate = new DateOnly(GetWeekStart(DateTime.Now).Year, GetWeekStart(DateTime.Now).Month, GetWeekStart(DateTime.Now).Day);
        currentEventWeek.EndDate = currentEventWeek.StartDate.AddDays(6);

    }
    
    public static DateTime GetWeekStart(DateTime date, DayOfWeek firstDayOfWeek = DayOfWeek.Monday)
    {
        int diff = (7 + (date.DayOfWeek - firstDayOfWeek)) % 7;
        DateTime start = date.AddDays(-diff).Date;
        return start;
    }

    private async Task<UserRecord> GetUserData()
    {
        var username = AuthenticationStateProvider.GetAuthenticationStateAsync().Result.User.Identity.Name;
        var UserData = await Db.Users.Where(w => w.Username == username).ToListAsync();
        return UserData[0];
    }
    
    private async Task GetDataFromDB()
    {
        //var userName = AuthenticationStateProvider.GetAuthenticationStateAsync().Result.User.Identity.Name;
        var DbEvents = await Db.PlannerEvents.OrderBy(e => e.Id).ToListAsync();
        events = DbEvents;
    }
    
    private async Task GetUserDataFromDB()
    {
        var userName = AuthenticationStateProvider.GetAuthenticationStateAsync().Result.User.Identity.Name;
        var DbEvents = await Db.PlannerEvents.Where(w => w.Owner.Username == userName).OrderBy(e => e.LocalId).ToListAsync();
        userEvents = DbEvents;
    }

    public static string GenerateSimpleColorWithFixedSL()
    {
        var random = new Random();
        double hue = random.NextDouble() * 360;
        double saturation = 0.94;
        double lightness = 0.94;

        double c = (1 - Math.Abs(2 * lightness - 1)) * saturation;
        double x = c * (1 - Math.Abs((hue / 60) % 2 - 1));
        double m = lightness - c / 2;

        double r, g, b;
        if (hue < 60) { r = c; g = x; b = 0; }
        else if (hue < 120) { r = x; g = c; b = 0; }
        else if (hue < 180) { r = 0; g = c; b = x; }
        else if (hue < 240) { r = 0; g = x; b = c; }
        else if (hue < 300) { r = x; g = 0; b = c; }
        else { r = c; g = 0; b = x; }

        int R = (int)((r + m) * 255);
        int G = (int)((g + m) * 255);
        int B = (int)((b + m) * 255);

        return $"#{R:X2}{G:X2}{B:X2}";
    }

    private void HandleMouseDown(int col, int hour)
    {
        if (col == 0) return;
        isSelecting = true;
        startCol = col;
        var n = currentEventWeek.StartDate.AddDays(col - 1);
        startTime = new DateTime(n.Year, n.Month, n.Day, hour, 0, 0);
        currentSelection.Clear();
        currentSelection.Add((col, hour));
    }

    private void HandleMouseMove(int col, int hour)
    {
        if (!isSelecting || col == 0) return;
        
        CalculateSelection(hour);
        StateHasChanged();
    }

    private void HandleMouseUp()
    {
        if (!isSelecting) return;
        
        isSelecting = false;
        
        if (currentSelection.Count > 0)
        {
            if (currentSelection.Any(c => c.col == 0)) return;
            CreateEvent("New Event", startCol ?? 0);
        }
        StateHasChanged();
    }

    private void CalculateSelection(int endHour)
    {
        if (!startCol.HasValue) return;

        currentSelection.Clear();
        
        int minHour = Math.Min(startTime.Hour, endHour);
        int maxHour = Math.Max(startTime.Hour, endHour);


            for (int hour = minHour; hour <= maxHour; hour++)
            {
                currentSelection.Add((startCol.Value, hour));
            }
    }

    private bool IsSelected(int col, int hour)
    {
        return currentSelection.Any(c => c.col == col && c.hour == hour);
    }

    private void CreateEvent(string name, int day)
    {
        var n = currentEventWeek.StartDate.AddDays(day - 1);
        DateTime start = new DateTime(n.Year, n.Month, n.Day, currentSelection[0].hour, 0, 0);
        DateTime end = new DateTime(n.Year, n.Month, n.Day, currentSelection.Last().hour, 59, 0);
        foreach (PlannerEvent existingEvent in GetEventsInColumn(day).OrderBy(e => e.LocalId))
        {
            if (start < existingEvent.EndTime && existingEvent.StartTime < end)
            {
                TimeSpan beforeSpace = existingEvent.StartTime - start;
                TimeSpan afterSpace = end - existingEvent.EndTime;

                if (beforeSpace > afterSpace)
                {
                    end = existingEvent.StartTime.AddMinutes(-1);
                }
                else
                {
                    start = existingEvent.EndTime.AddMinutes(1);
                }
            }
        }

        if (end <= start)
        {
            currentSelection.Clear();
            return;
        }

        PlannerEvent eventToSave = new PlannerEvent
        {
            Name = name,
            StartTime = start,
            EndTime = end,
            Color = GenerateSimpleColorWithFixedSL(),
            Text = "",
            Owner = GetUserData().Result
        };
        SaveEventToDB(eventToSave);
        events.Add(eventToSave);
        for (int i = 0; i <= userEvents.Count; i++)
        {
            eventToSave.LocalId = i;
        }
        userEvents.Add(eventToSave);
        
        currentSelection.Clear();
    }

    private void SaveEventToDB(PlannerEvent eventToDb)
    {
        Db.PlannerEvents.Update(eventToDb);
        Db.SaveChanges();
    }

    private List<PlannerEvent> GetEventsInColumn(int column)
    {
        return userEvents
            .Where(e => ((int)e.StartTime.DayOfWeek + 6) % 7 + 1 == column)
            .ToList();
    }

    private void ShowEditModal(int eventLocalId)
    {
        currentEvent = userEvents[eventLocalId];
        EditEventName = currentEvent.Name;
        EditEventText = currentEvent.Text ?? "";
        startTime = currentEvent.StartTime;
        endTime = currentEvent.EndTime;
        SelectedColor = currentEvent.Color;
        ModalDisplay = "block";
        ModalClass = "show";
        ShowBackdrop = true;
    }

    private void CloseModal()
    {
        ModalDisplay = "none";
        ModalClass = "";
        ShowBackdrop = false;
        AlertClass = "";
        currentEvent = null;
    }

    private void SaveEvent()
    {
        if (currentEvent != null)
        {
            startTime = new DateTime(currentEvent.StartTime.Year, currentEvent.StartTime.Month, currentEvent.StartTime.Day, startTime.Hour, startTime.Minute, startTime.Second);
            endTime = new DateTime(currentEvent.StartTime.Year, currentEvent.StartTime.Month, currentEvent.StartTime.Day, endTime.Hour, endTime.Minute, endTime.Second);
            
            AlertClass = "alert-success";
            var otherEvents = GetEventsInColumn(((int)currentEvent.StartTime.DayOfWeek + 6) % 7 + 1)
                .Where(e => e.Id != currentEvent.Id)
                .ToList();

            foreach (var ev in otherEvents)
            {
                if (startTime < ev.EndTime && ev.StartTime < endTime)
                {
                    AlertClass = "alert-danger";
                    AlertText = "Event overlaps with another event :(";
                    break;
                }
            }

            if (startTime > endTime)
            {
                AlertClass = "alert-danger";
                AlertText = "Event has invalid time range :I";
            }
            currentEvent.Name = EditEventName;
            currentEvent.Text = EditEventText;
            currentEvent.Color = SelectedColor;
            if (AlertClass == "alert-success")
            {
                AlertText = "Event successfuly edited :)";
                currentEvent.StartTime = startTime;
                currentEvent.EndTime = endTime;
            }
            
            SaveEventToDB(currentEvent);
        }
    }

    private void DeleteEvent()
    {
        if (currentEvent != null)
        {
            events.Remove(currentEvent);
            userEvents.Remove(currentEvent);
            for (int i = 0; i < userEvents.Count; i++)
            {
                userEvents[i].LocalId = i;
            }
            Db.PlannerEvents.Remove(currentEvent);
            Db.SaveChanges();
        }
        CloseModal();
    }
}