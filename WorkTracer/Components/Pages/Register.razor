@page "/register"
@using Microsoft.AspNetCore.Identity
@using WorkTracer.Data
@using WorkTracer.Services
@using WorkTracer.Models
@rendermode InteractiveServer

@inject NavigationManager navigation
@inject ApplicationDbContext Db

<PageTitle>Register</PageTitle>

<AuthorizeView>
    <Authorized Context="user">
        <div class="d-flex justify-content-center align-items-center min-vh-100 bg-light">
            <div class="card shadow p-4" style="width: 100%; max-width: 400px;">
                <h3 class="text-center mb-4">Login</h3>

                @if (error)
                {
                    <div class="alert alert-danger" role="alert">
                        <strong>Error:</strong> Something went wrong. Error message: @errorMessage
                    </div>
                }
                @if (success)
                {
                    <div class="alert alert-success" role="alert">
                        <strong>Success!</strong> User registered successfully.
                    </div>
                }

                <EditForm Model="@registerModel" OnValidSubmit="HandleRegister" FormName="RegisterForm">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <InputText @bind-Value="registerModel.Username" class="form-control" placeholder="Username" />
                    </div>
                    
                    <div class="mb-3">
                        <InputText @bind-Value="registerModel.Email" class="form-control" placeholder="Email" />
                    </div>

                    <div class="mb-3">
                        <InputText @bind-Value="registerModel.Password" type="password" class="form-control" placeholder="Password" />
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">Register new user</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="container-fluid">
            <p>Only the administrator can register new users. Log in to Create a new account.</p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code
{
    private RegisterModel registerModel = new();
    private bool error = false;
    private string errorMessage = string.Empty;
    private bool success = false;
    
    private async Task HandleRegister()
    {
        UserStore userStore = new UserStore(Db);
        try
        {
            var result = await userStore.CreateAsync(ConvertToAppUser(registerModel), CancellationToken.None);
            if (!result.Succeeded)
            {
                error = true;
                errorMessage = $"Registration failed: {string.Join(", ", result.Errors.Select(e => e.Description))}";
                return;
            }
            success = true;
        }
        catch (Exception ex)
        {
            error = true;
            errorMessage = ex.Message;
        }
    }
    
    private ApplicationUser ConvertToAppUser(RegisterModel model)
    {
        // Convert RegisterModel to ApplicationUser
        return new ApplicationUser
        {
            UserName = model.Username,
            NormalizedUserName = model.Username,
            Email = model.Email,
            NormalizedEmail = model.Email,
            PasswordHash = new PasswordHasher<ApplicationUser>().HashPassword(null, model.Password) // This should be hashed in a real application
        };
    }
}
