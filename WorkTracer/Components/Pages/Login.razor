@page "/login"
@rendermode InteractiveServer
@using System.Net
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@inject AuthService authService
@inject NavigationManager navigation

<PageTitle>Login</PageTitle>

<EditForm FormName="LoginDialog" Model=@Credentials OnValidSubmit="HandleLogin">
    <div class="mb-3">
        <InputText id="Username" @bind-Value=Credentials.Username class="form-control" placeholder="Username" />
    </div>
    <div class="mb-3">
        <InputText id="Password" @bind-Value=Credentials.Password type="password" class="form-control" placeholder="Password" />
    </div>
    <div class="mb-3">
        <input type="submit" class="btn btn-primary" value="Login" />
    </div>
    
</EditForm>
@if (loginFailed)
{
    <div class="alert alert-danger" role="alert">
        <p><strong>Error:</strong> incorrect username or password.</p>
    </div>
}

@code {
    Credentials Credentials = new Credentials();
    private bool loginFailed = false;

    private async Task HandleLogin(EditContext obj)
    {
        bool result = authService.Login(Credentials.Username, Credentials.Password);
        if (result)
        {
            navigation.NavigateTo("/", false);
        }
        else
        {
            loginFailed = true;
        }
    }
}
