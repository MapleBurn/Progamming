@inherits LayoutComponentBase
@inject NavigationManager navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="page">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <a href="" target="_blank">logged in as: @context.User.Identity?.Name</a>
                    <button class="btn btn-danger" action="Auth/CookieLogout">Log out</button>
                </Authorized>
                <NotAuthorized>
                    <a href="login">log in</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

