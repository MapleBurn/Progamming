@page "/planner"
@rendermode InteractiveServer
@attribute [Authorize]
@inject NavigationManager navigation

<div class="planner-container">
    <!-- Header Row -->
    <div class="row planner-header">
        <div class="col"></div>
        <div class="col text-center">Monday</div>
        <div class="col text-center">Tuesday</div>
        <div class="col text-center">Wednesday</div>
        <div class="col text-center">Thursday</div>
        <div class="col text-center">Friday</div>
        <div class="col text-center">Saturday</div>
        <div class="col text-center">Sunday</div>
    </div>
    
    <!-- Grid cells -->
    <div class="row">
        @for (int col = 0; col <= 7; col++)
        {
            int currentCol = col;
            <div class="col p-0">
                <div id="@($"col-{currentCol}")" style="position: relative; height: 960px;">
                    @for (int hour = 0; hour < 24; hour++)
                    {
                        int currentHour = hour;
                        <div class="planner-cell @(IsSelected(currentCol, currentHour) ? "selecting" : "")" 
                             @onmousedown="() => HandleMouseDown(currentCol, currentHour)" 
                             @onmousemove="() => HandleMouseMove(currentCol, currentHour)"
                             @onmouseup="HandleMouseUp"
                             data-col="@currentCol" 
                             data-hour="@currentHour">
                            
                            @if (col == 0)
                            {
                                <div class="hour-label">@(currentHour):00</div>
                            }
                        </div>
                    }
                    
                    @foreach (var evt in GetEventsInColumn(currentCol))
                    {
                        var columnCells = evt.Cells.Where(c => c.col == currentCol).ToList();
                        @if (columnCells.Any())
                        {
                            var minHour = columnCells.Min(c => c.hour);
                            var maxHour = columnCells.Max(c => c.hour);
                            <div class="event-block"
                                 style="top: @((minHour) * 40)px; height: @((maxHour - minHour + 1) * 40)px"
                                 data-event-id="@evt.Id"
                                 @onclick:stopPropagation="true"
                                 @onclick="() => ShowEditModal(evt.Id)">
                                <p1>@evt.Name</p1><br><br>
                                <p1 style="overflow-wrap: break-word; word-break: break-all; white-space: pre-wrap;">
                                    @evt.Text
                                </p1>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Edit Event Modal -->
<div class="modal @ModalClass" tabindex="-1" role="dialog" style="display:@ModalDisplay">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Event</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" @onclick="CloseModal"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="editEventName" class="form-control mb-3" placeholder="Event name" @bind="EditEventName">
                <InputTextArea id="EditEventText" class="form-control mb-3" placeholder="Text" @bind-Value="EditEventText" rows="6"/>
                <div class="d-flex justify-content-between">
                    <button type="button" class="btn btn-danger" id="deleteEvent" @onclick="DeleteEvent">Delete</button>
                    <button type="button" class="btn btn-primary" id="saveEvent" @onclick="SaveEvent">Save Changes</button>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ShowBackdrop)
{
    <div class="modal-backdrop fade show"></div>
}

@code {
    private Dictionary<string, PlannerEvent> events = new Dictionary<string, PlannerEvent>();
    private PlannerEvent currentEvent;
    private bool isSelecting;
    private int? startCol;
    private int? startHour;
    private List<(int col, int hour)> currentSelection = new List<(int col, int hour)>();
    
    // Modal properties
    private string ModalDisplay = "none";
    private string ModalClass = "";
    private bool ShowBackdrop;
    private string EditEventName { get; set; } = "";
    private string EditEventText { get; set; } = "";

    private void HandleMouseDown(int col, int hour)
    {
        if (col == 0) return;
        //if (GetEventsInCell(col, hour).Any()) return;

        isSelecting = true;
        startCol = col;
        startHour = hour;
        currentSelection.Clear();
        currentSelection.Add((col, hour));
    }

    private void HandleMouseMove(int col, int hour)
    {
        if (!isSelecting || col == 0) return;
        
        CalculateSelection(col, hour);
        StateHasChanged();
    }

    private void HandleMouseUp()
    {
        if (!isSelecting) return;
        
        isSelecting = false;
        
        if (currentSelection.Count > 0)
        {
            if (currentSelection.Any(c => c.col == 0)) return;
            CreateEvent("New Event");
        }
        StateHasChanged();
    }

    private void CalculateSelection(int endCol, int endHour)
    {
        if (!startCol.HasValue || !startHour.HasValue) return;

        currentSelection.Clear();

        int minCol = Math.Min(startCol.Value, endCol);
        int maxCol = Math.Max(startCol.Value, endCol);
        int minHour = Math.Min(startHour.Value, endHour);
        int maxHour = Math.Max(startHour.Value, endHour);

        for (int col = minCol; col <= maxCol; col++)
        {
            for (int hour = minHour; hour <= maxHour; hour++)
            {
                currentSelection.Add((col, hour));
            }
        }
    }

    private bool IsSelected(int col, int hour)
    {
        return currentSelection.Any(c => c.col == col && c.hour == hour);
    }

    private void CreateEvent(string name)
    {
        var eventsToAdd = new List<PlannerEvent>();
        var eventsToRemove = new List<string>();

        // Process existing events for splitting
        foreach (var existingEvent in events.Values.ToList())
        {
            var overlap = existingEvent.Cells.Intersect(currentSelection).ToList();
            if (overlap.Count == 0) continue;

            var remainingCells = existingEvent.Cells.Except(currentSelection).ToList();
            var columns = remainingCells.GroupBy(c => c.col);

            foreach (var colGroup in columns)
            {
                var hours = colGroup.Select(c => c.hour)
                                  .OrderBy(h => h)
                                  .ToList();
                
                var blocks = GroupIntoContiguousBlocks(hours);
                
                foreach (var block in blocks)
                {
                    eventsToAdd.Add(new PlannerEvent {
                        Id = Guid.NewGuid().ToString(),
                        Name = existingEvent.Name,
                        Text = existingEvent.Text,
                        Cells = block.Select(h => (colGroup.Key, h)).ToList()
                    });
                }
            }
            
            eventsToRemove.Add(existingEvent.Id);
        }

        // Update event dictionary
        foreach (var id in eventsToRemove) events.Remove(id);
        foreach (var evt in eventsToAdd) events[evt.Id] = evt;

        // Add new event
        var newId = Guid.NewGuid().ToString();
        events[newId] = new PlannerEvent {
            Id = newId,
            Name = name,
            Cells = currentSelection.ToList()
        };
        
        currentSelection.Clear();
    }

    private List<List<int>> GroupIntoContiguousBlocks(List<int> hours)
    {
        if (!hours.Any()) return new List<List<int>>();
        
        var blocks = new List<List<int>>();
        var currentBlock = new List<int> { hours[0] };

        for (int i = 1; i < hours.Count; i++)
        {
            if (hours[i] == currentBlock.Last() + 1)
                currentBlock.Add(hours[i]);
            else
            {
                blocks.Add(currentBlock);
                currentBlock = new List<int> { hours[i] };
            }
        }
        blocks.Add(currentBlock);
        
        return blocks;
    }

    private List<PlannerEvent> GetEventsInCell(int col, int hour)
    {
        return events.Values
            .Where(e => e.Cells.Any(c => c.col == col && c.hour == hour))
            .ToList();
    }

    private List<PlannerEvent> GetEventsInColumn(int column)
    {
        return events.Values
            .Where(e => e.Cells.Any(c => c.col == column))
            .ToList();
    }

    private void ShowEditModal(string eventId)
    {
        if (events.TryGetValue(eventId, out currentEvent))
        {
            EditEventName = currentEvent.Name;
            EditEventText = currentEvent.Text ?? "";
            ModalDisplay = "block";
            ModalClass = "show";
            ShowBackdrop = true;
        }
    }

    private void CloseModal()
    {
        ModalDisplay = "none";
        ModalClass = "";
        ShowBackdrop = false;
        currentEvent = null;
    }

    private void SaveEvent()
    {
        if (currentEvent != null)
        {
            currentEvent.Name = EditEventName;
            currentEvent.Text = EditEventText;
        }
        CloseModal();
    }

    private void DeleteEvent()
    {
        if (currentEvent != null)
        {
            events.Remove(currentEvent.Id);
        }
        CloseModal();
    }
}