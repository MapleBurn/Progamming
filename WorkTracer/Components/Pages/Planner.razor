@page "/planner"
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Enhanced Work Planner</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    .planner-cell {
      position: relative;
      border: 1px solid #ececec;
      height: 40px;
      background: #f8f9fa;
      cursor: pointer;
    }
    .event-block {
      position: absolute;
      left: 2px;
      right: 2px;
      top: 2px;
      bottom: 2px;
      background: #e1f5fe;
      border-radius: 4px;
      padding: 4px 8px;
      border: 1px solid #90caf9;
      cursor: pointer;
      overflow: hidden;
      transition: transform 0.1s;
      z-index: 1;
    }
    .selecting {
      background: #d4edda !important;
    }
    .event-block:hover {
      transform: scale(1.02);
      z-index: 2;
    }
  </style>
</head>
<body>
  <!-- Previous container/header structure remains the same -->
  <!-- Edit Event Modal -->
  <div class="modal fade" id="eventModal">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Edit Event</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="text" id="editEventName" class="form-control mb-3" placeholder="Event name">
          <div class="d-flex justify-content-between">
            <button type="button" class="btn btn-danger" id="deleteEvent">Delete</button>
            <button type="button" class="btn btn-primary" id="saveEvent">Save Changes</button>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script>
    class EventManager {
      constructor() {
        this.events = new Map();
        this.currentEvent = null;
        this.isSelecting = false;
        this.startCell = null;
        this.currentSelection = [];
      }
      init() {
        this.setupEventListeners();
        this.generateGrid();
      }
      setupEventListeners() {
        document.addEventListener('mousedown', e => this.handleMouseDown(e));
        document.addEventListener('mousemove', e => this.handleMouseMove(e));
        document.addEventListener('mouseup', () => this.handleMouseUp());
        document.getElementById('saveEvent').addEventListener('click', () => this.saveEvent());
        document.getElementById('deleteEvent').addEventListener('click', () => this.deleteEvent());
      }
      handleMouseDown(e) {
        const cell = e.target.closest('.planner-cell');
        if (!cell || cell.closest('.planner-time-cell')) return;
        
        if (e.target.closest('.event-block')) {
          this.showEditModal(e.target.closest('.event-block'));
          return;
        }
        this.isSelecting = true;
        this.startCell = cell;
        this.currentSelection = [cell];
        cell.classList.add('selecting');
      }
      handleMouseMove(e) {
        if (!this.isSelecting) return;
        
        const cell = e.target.closest('.planner-cell');
        if (!cell || cell === this.currentSelection[this.currentSelection.length-1]) return;
        this.clearSelection();
        this.calculateSelection(cell);
      }
      handleMouseUp() {
        if (!this.isSelecting) return;
        this.isSelecting = false;
        this.clearSelection();
        
        const eventName = prompt('Enter event name:');
        if (eventName) this.createEvent(eventName);
      }
      calculateSelection(endCell) {
        const startCol = parseInt(this.startCell.parentElement.id.split('-')[1]);
        const startHour = parseInt(this.startCell.dataset.hour);
        const endCol = parseInt(endCell.parentElement.id.split('-')[1]);
        const endHour = parseInt(endCell.dataset.hour);
        const minCol = Math.min(startCol, endCol);
        const maxCol = Math.max(startCol, endCol);
        const minHour = Math.min(startHour, endHour);
        const maxHour = Math.max(startHour, endHour);
        this.currentSelection = [];
        for(let col = minCol; col <= maxCol; col++) {
          const column = document.getElementById(`col-${col}`);
          const cells = column.querySelectorAll('.planner-cell');
          for(let h = minHour; h <= maxHour; h++) {
            cells[h].classList.add('selecting');
            this.currentSelection.push(cells[h]);
          }
        }
      }
      createEvent(name) {
        const eventId = Date.now().toString();
        const eventElements = this.currentSelection.map(cell => {
          const event = document.createElement('div');
          event.className = 'event-block';
          event.textContent = name;
          event.dataset.eventId = eventId;
          event.addEventListener('click', e => this.showEditModal(e.target));
          cell.appendChild(event);
          return event;
        });
        
        this.events.set(eventId, {
          name,
          elements: eventElements,
          cells: this.currentSelection
        });
      }
      showEditModal(eventElement) {
        const eventId = eventElement.dataset.eventId;
        this.currentEvent = this.events.get(eventId);
        document.getElementById('editEventName').value = this.currentEvent.name;
        new bootstrap.Modal('#eventModal').show();
      }
      saveEvent() {
        const newName = document.getElementById('editEventName').value;
        this.currentEvent.elements.forEach(element => {
          element.textContent = newName;
        });
        this.currentEvent.name = newName;
        new bootstrap.Modal('#eventModal').hide();
      }
      deleteEvent() {
        this.currentEvent.elements.forEach(element => element.remove());
        this.events.delete(this.currentEvent.elements[0].dataset.eventId);
        new bootstrap.Modal('#eventModal').hide();
      }
      clearSelection() {
        document.querySelectorAll('.selecting').forEach(c => c.classList.remove('selecting'));
      }
      generateGrid() {
      }
    }
    new EventManager().init();
  </script>
</body>
</html>



<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Bootstrap Work Planner</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href=https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css rel="stylesheet">
  <style>
    .planner-container {
      width: 70vw;
      margin: 40px auto;
      background: #fff;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      overflow: hidden;
    }
    .planner-header {
      background: #0074d9;
      color: #fff;
      font-weight: bold;
      text-align: center;
    }
    .planner-cell {
      border: 1px solid #ececec;
      min-height: 40px;
      padding: 4px;
      position: relative;
      background: #f8f9fa;
    }
    .task-list {
      list-style: none;
      padding-left: 0;
      margin-bottom: 0;
    }
    .task-item {
      background: #e1f5fe;
      border-radius: 4px;
      margin-bottom: 2px;
      padding: 2px 6px;
      font-size: 0.95em;
      word-break: break-word;
    }
  </style>
</head>
<body>
  <div class="planner-container">
    <!-- Header Row -->
    <div class="row planner-header">
      <div class="col text-center"></div>
      <div class="col text-center">Monday</div>
      <div class="col text-center">Tuesday</div>
      <div class="col text-center">Wednesday</div>
      <div class="col text-center">Thursday</div>
      <div class="col text-center">Friday</div>
      <div class="col text-center">Saturday</div>
      <div class="col text-center">Sunday</div>
    </div>
    <div class="row">
      <div class="col p-0">
        <div id="col-0"></div>
      </div>
      <div class="col p-0"><div id="col-1"></div></div>
      <div class="col p-0"><div id="col-2"></div></div>
      <div class="col p-0"><div id="col-3"></div></div>
      <div class="col p-0"><div id="col-4"></div></div>
      <div class="col p-0"><div id="col-5"></div></div>
      <div class="col p-0"><div id="col-6"></div></div>
      <div class="col p-0"><div id="col-7"></div></div>
    </div>
  </div>
 
  <!-- Bootstrap JS CDN -->
  <script src=https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js></script>
  <script>
    // Generate 24 rows per column
    for(let day = 0; day <= 7; day++) {
      const col = document.getElementById('col-' + day);
      for(let hour = 1; hour <= 24; hour++) {
        const cell = document.createElement('div');
        cell.className = 'planner-cell';
        cell.dataset.day = day-1;
        cell.dataset.hour = hour;
 
        // Display hour label in the first column
        if(day === 0) {
          const hourLabel = document.createElement('div');
          hourLabel.style.position = 'absolute';
          hourLabel.style.left = '16px';
          hourLabel.style.top = '10px';
          hourLabel.style.fontSize = '0.8em';
          hourLabel.style.opacity = '0.5';
          hourLabel.textContent = hour + ':00';
          cell.appendChild(hourLabel);
        }
 
        // Task list
        const tasksList = document.createElement('ul');
        tasksList.className = 'task-list';
 
        cell.appendChild(tasksList);
 
        col.appendChild(cell);
      }
    }
  </script>
</body>
</html>