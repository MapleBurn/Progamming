@page "/planner"
@rendermode InteractiveServer

<div class="planner-container">
    <!-- Header Row -->
    <div class="row planner-header">
        <div class="col"></div>
        <div class="col text-center">Monday</div>
        <div class="col text-center">Tuesday</div>
        <div class="col text-center">Wednesday</div>
        <div class="col text-center">Thursday</div>
        <div class="col text-center">Friday</div>
        <div class="col text-center">Saturday</div>
        <div class="col text-center">Sunday</div>
    </div>
    
    <!-- Grid cells -->
    <div class="row">
        @for (int col = 0; col <= 7; col++)
        {
            int currentCol = col;
            <div class="col p-0">
                <div id="@($"col-{currentCol}")">
                    @for (int hour = 1; hour <= 24; hour++)
                    {
                        int currentHour = hour;
                        <div class="planner-cell @(IsSelected(currentCol, currentHour) ? "selecting" : "")" 
                             @onmousedown="() => HandleMouseDown(currentCol, currentHour)" 
                             @onmousemove="() => HandleMouseMove(currentCol, currentHour)"
                             @onmouseup="HandleMouseUp"
                             data-col="@currentCol" 
                             data-hour="@currentHour">
                            
                            @if (col == 0)
                            {
                                <div class="hour-label">@(currentHour):00</div>
                            }
                            
                            @foreach (var evt in GetEventsInCell(currentCol, currentHour))
                            {
                                <div class="event-block" 
                                     data-event-id="@evt.Id" 
                                     @onclick:stopPropagation="true"
                                     @onclick="() => ShowEditModal(evt.Id)">
                                    @evt.Name
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Edit Event Modal -->
<div class="modal @ModalClass" tabindex="-1" role="dialog" style="display:@ModalDisplay">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Event</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" @onclick="CloseModal"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="editEventName" class="form-control mb-3" placeholder="Event name" @bind="EditEventName">
                <div class="d-flex justify-content-between">
                    <button type="button" class="btn btn-danger" id="deleteEvent" @onclick="DeleteEvent">Delete</button>
                    <button type="button" class="btn btn-primary" id="saveEvent" @onclick="SaveEvent">Save Changes</button>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ShowBackdrop)
{
    <div class="modal-backdrop fade show"></div>
}

@code {
    private Dictionary<string, PlannerEvent> events = new Dictionary<string, PlannerEvent>();
    private PlannerEvent currentEvent;
    private bool isSelecting = false;
    private int? startCol;
    private int? startHour;
    private List<(int col, int hour)> currentSelection = new List<(int col, int hour)>();
    private int? endHour;
    
    // Modified event class
    private void HandleMouseDown(int col, int hour)
    {
        if (col == 0) return;
        
        startCol = col;
        startHour = hour;
        endHour = hour;
        isSelecting = true;
    }
    private void HandleMouseMove(int col, int hour)
    {
        if (!isSelecting || col != startCol) return;
        endHour = hour;
    }
    private void HandleMouseUp()
    {
        if (!isSelecting) return;
        
        isSelecting = false;
        var duration = Math.Abs(endHour!.Value - startHour!.Value) + 1;
        var newEvent = new PlannerEvent
        {
            Id = Guid.NewGuid().ToString(),
            Column = startCol!.Value,
            StartHour = Math.Min(startHour.Value, endHour.Value),
            Duration = duration
        };
        // Split overlapping events
        var overlapping = events.Values
            .Where(e => e.Column == newEvent.Column && 
                      !(e.StartHour >= newEvent.StartHour + newEvent.Duration || 
                        e.StartHour + e.Duration <= newEvent.StartHour))
            .ToList();
        foreach (var existing in overlapping)
        {
            events.Remove(existing.Id);
            
            // Split into non-overlapping parts
            if (existing.StartHour < newEvent.StartHour)
            {
                events.Add(Guid.NewGuid().ToString(), new PlannerEvent {
                    Column = existing.Column,
                    StartHour = existing.StartHour,
                    Duration = newEvent.StartHour - existing.StartHour,
                    Name = existing.Name
                });
            }
            
            if (existing.StartHour + existing.Duration > newEvent.StartHour + newEvent.Duration)
            {
                events.Add(Guid.NewGuid().ToString(), new PlannerEvent {
                    Column = existing.Column,
                    StartHour = newEvent.StartHour + newEvent.Duration,
                    Duration = existing.StartHour + existing.Duration - (newEvent.StartHour + newEvent.Duration),
                    Name = existing.Name
                });
            }
        }
        ShowCreateModal(newEvent);
    }
    private void ShowCreateModal(PlannerEvent newEvent)
    {
        currentEvent = newEvent;
        EditEventName = "";
        ModalDisplay = "block";
        ModalClass = "show";
        ShowBackdrop = true;
    }
    private void SaveEvent()
    {
        if (currentEvent != null)
        {
            currentEvent.Name = EditEventName;
            events[currentEvent.Id] = currentEvent;
        }
        CloseModal();
    }
    
    // Modal properties
    private string ModalDisplay = "none";
    private string ModalClass = "";
    private bool ShowBackdrop = false;
    private string EditEventName { get; set; } = "";


    private void ClearSelection()
    {
        currentSelection.Clear();
    }

    private void CalculateSelection(int endCol, int endHour)
    {
        if (!startCol.HasValue || !startHour.HasValue) return;

        int minCol = Math.Min(startCol.Value, endCol);
        int maxCol = Math.Max(startCol.Value, endCol);
        int minHour = Math.Min(startHour.Value, endHour);
        int maxHour = Math.Max(startHour.Value, endHour);

        for (int col = minCol; col <= maxCol; col++)
        {
            for (int hour = minHour; hour <= maxHour; hour++)
            {
                currentSelection.Add((col, hour));
            }
        }
    }

    private bool IsSelected(int col, int hour)
    {
        return currentSelection.Any(c => c.col == col && c.hour == hour);
    }

    private void CreateEvent(string name)
    {
        var eventId = Guid.NewGuid().ToString();
        var cells = currentSelection.ToList();
        
        var newEvent = new PlannerEvent
        {
            Id = eventId,
            Name = name,
            Cells = cells
        };
        
        events[eventId] = newEvent;
        currentSelection.Clear();
    }

    private List<PlannerEvent> GetEventsInCell(int col, int hour)
    {
        return events.Values
            .Where(e => e.Cells.Any(c => c.col == col && c.hour == hour))
            .ToList();
    }

    private void ShowEditModal(string eventId)
    {
        if (events.TryGetValue(eventId, out currentEvent))
        {
            EditEventName = currentEvent.Name;
            ModalDisplay = "block";
            ModalClass = "show";
            ShowBackdrop = true;
        }
    }

    private void CloseModal()
    {
        ModalDisplay = "none";
        ModalClass = "";
        ShowBackdrop = false;
        currentEvent = null;
    }

    private void DeleteEvent()
    {
        if (currentEvent != null)
        {
            events.Remove(currentEvent.Id);
        }
        CloseModal();
    }
}